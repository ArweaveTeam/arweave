#!/usr/bin/env bash

SCRIPT_DIR="$(dirname "$0")"
cd "$SCRIPT_DIR/.."

# Honour ARWEAVE_NAMESPACE so several checkouts can run side by side.
[ -f "$SCRIPT_DIR/dev/lib-namespace.sh" ] && . "$SCRIPT_DIR/dev/lib-namespace.sh"

./ar-rebar3 localnet compile

SNAPSHOT_DIR="${1:-localnet_snapshot}"

export ERL_EPMD_ADDRESS=127.0.0.1

ERL_LOCALNET_OPTS="-pa $(./rebar3 as localnet path) $(./rebar3 as localnet path --base)/lib/arweave/test -config config/sys.config"
echo -e "\033[0;32m===> Starting localnet shell from ${SNAPSHOT_DIR}...\033[0m"

NODE="main-localnet${ARWEAVE_NS_SUFFIX:-}@127.0.0.1"
# Refuse only if a node with *this* name is already running; nodes in other
# namespaces (e.g. other workspaces) are allowed to run concurrently.
if pgrep -f -- "-name ${NODE}" > /dev/null; then
    echo "A node named ${NODE} is already running. Exiting."
    exit 1
else
    erl $ERL_LOCALNET_OPTS -name "${NODE}" -setcookie localnet -noshell -s ar shell_localnet "$SNAPSHOT_DIR" -s shell start_interactive 2>&1
fi
kill 0

