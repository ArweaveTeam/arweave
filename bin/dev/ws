#!/usr/bin/env bash
#
# ws — Arweave development workspace manager
#
# A "workspace" is an isolated copy of the repo (a git worktree) plus a named
# screen session and a unique Erlang test namespace. It lets several engineers
# or agents build and run the test suite concurrently on one machine without
# colliding on EPMD, node names, ports, or .tmp/data_* directories.
#
# See doc/workspaces.md for the full story.
#
set -euo pipefail

PROG=ws
SCREEN_PREFIX=ws-
SESSION_SEP='#'          # separates a workspace from its shell number: ws-foo#2
EPMD_PORT_BASE=4370
EPMD_PORT_MAX=4469

err()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '\033[0;32m==>\033[0m %s\n' "$*"; }

# --- repo discovery -------------------------------------------------------

git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "not inside a git repository — run $PROG from within the arweave repo"

# The main worktree's root, stable no matter which worktree we are invoked from.
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
[ -n "$COMMON_DIR" ] || COMMON_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
MAIN_ROOT=$(dirname "$COMMON_DIR")
[ -x "$MAIN_ROOT/ar-rebar3" ] \
  || die "this does not look like the arweave repo (no ar-rebar3 at $MAIN_ROOT)"

WS_ROOT=${ARWEAVE_WS_ROOT:-$(dirname "$MAIN_ROOT")/arweave-workspaces}
META_DIR=$WS_ROOT/.meta

# --- helpers --------------------------------------------------------------

valid_name() {
  case ${1:-} in
    ''|*[!a-zA-Z0-9._-]*) return 1 ;;
    *)                    return 0 ;;
  esac
}

wt_path()   { printf '%s/%s' "$WS_ROOT" "$1"; }
rc_path()   { printf '%s/%s.rc' "$META_DIR" "$1"; }
session()   { printf '%s%s' "$SCREEN_PREFIX" "$1"; }                # primary
session_n() { printf '%s%s%s%s' "$SCREEN_PREFIX" "$1" "$SESSION_SEP" "$2"; }

# True if a screen session with this exact name is alive (attached or not).
screen_alive() {
  local re=${1//./\\.}                          # '.' is a regex metacharacter
  screen -ls 2>/dev/null | grep -qE "[0-9]+\.${re}[[:space:]]"
}
session_running() { screen_alive "$(session "$1")"; }

# Every live screen session of workspace <name>: the primary 'ws-<name>' plus
# any 'ws-<name>#N' opened by '$PROG shell'. One session name per line.
workspace_sessions() {
  local re; re=$(session "$1"); re=${re//./\\.}
  screen -ls 2>/dev/null \
    | grep -oE "[0-9]+\.${re}(${SESSION_SEP}[0-9]+)?[[:space:]]" \
    | sed -E 's/^[0-9]+\.//; s/[[:space:]]+$//' \
    | sort -u
}

# Lowest N>=2 with no live 'ws-<name>#N' session — the next free shell slot.
next_session_n() {
  local n=2 re used
  re=$(session "$1"); re=${re//./\\.}
  used=$(screen -ls 2>/dev/null \
         | grep -oE "[0-9]+\.${re}${SESSION_SEP}[0-9]+[[:space:]]" \
         | grep -oE "${SESSION_SEP}[0-9]+" | tr -d "$SESSION_SEP" || true)
  while grep -qx "$n" <<<"$used"; do n=$((n + 1)); done
  printf '%s' "$n"
}

# Read a `setenv VAR value` line from a workspace's screen config.
rc_get() {
  awk -v v="$2" '$1=="setenv" && $2==v {print $3}' "$(rc_path "$1")" 2>/dev/null || true
}

# Lowest EPMD port in [BASE,MAX] not already claimed by another workspace.
pick_epmd_port() {
  local used port
  used=$(grep -hoE 'ERL_EPMD_PORT [0-9]+' "$META_DIR"/*.rc 2>/dev/null \
         | awk '{print $2}' || true)
  for ((port=EPMD_PORT_BASE; port<=EPMD_PORT_MAX; port++)); do
    grep -qx "$port" <<<"$used" || { printf '%s' "$port"; return 0; }
  done
  die "no free EPMD port in range $EPMD_PORT_BASE-$EPMD_PORT_MAX"
}

write_envrc() {  # write_envrc <name> <wt> <port>
  cat >"$2/.envrc" <<EOF
# Generated by '$PROG'. Sourced automatically inside the workspace's screen
# session; source it manually (or via direnv) for plain ssh shells:  . .envrc
export ARWEAVE_NAMESPACE=$1
export ERL_EPMD_PORT=$3
EOF
}

write_rc() {  # write_rc <name> <wt> <port>
  local name=$1 wt=$2 port=$3 rc
  rc=$(rc_path "$name")
  mkdir -p "$META_DIR"
  {
    echo "# Generated by '$PROG new $name' — do not edit by hand."
    # Keep screen out of the terminal's alternate buffer: without this,
    # attaching clears the visible terminal and detaching wipes the
    # session's scrollback. ti@/te@ make screen draw in the normal buffer.
    echo "termcapinfo xterm*|screen*|tmux* ti@:te@"
    # Advertise a 256-colour TERM (screen's default is a plain 'screen'), so
    # prompts and tools that gate colour on a *-256color $TERM keep their
    # highlighting inside the session.
    infocmp screen-256color >/dev/null 2>&1 && echo "term screen-256color"
    [ -f "$HOME/.screenrc" ] && echo "source $HOME/.screenrc"
    echo "chdir $wt"
    echo "setenv ARWEAVE_NAMESPACE $name"
    echo "setenv ERL_EPMD_PORT $port"
    echo "screen -t shell 0 bash"
  } >"$rc"
}

# --- subcommands ----------------------------------------------------------

cmd_new() {
  local name='' attach=1
  while [ $# -gt 0 ]; do
    case $1 in
      --no-attach) attach=0 ;;
      -*)          die "unknown option: $1" ;;
      *)           [ -z "$name" ] && name=$1 || die "unexpected argument: $1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: $PROG new <name> [--no-attach]"
  valid_name "$name" || die "invalid name '$name' — allowed: a-z A-Z 0-9 . _ -"

  local wt; wt=$(wt_path "$name")
  [ -e "$wt" ] && die "workspace path already exists: $wt"
  session_running "$name" && die "screen session $(session "$name") is already running"

  local port; port=$(pick_epmd_port)

  # The worktree starts on a detached HEAD at master. A git worktree cannot
  # share a branch with any other worktree (including the main checkout), and
  # a brand-new workspace has no work yet — so ws creates no branch. Check out
  # an existing branch, or start a new one, yourself once inside.
  local base=master
  git -C "$MAIN_ROOT" show-ref --verify --quiet refs/heads/master || base=HEAD
  info "Creating worktree $wt (detached HEAD at $base)"
  git -C "$MAIN_ROOT" worktree add --detach "$wt" "$base"

  info "Initialising submodules (RandomX, secp256k1, openssl-sha-lite)"
  git -C "$wt" submodule update --init --recursive

  write_envrc "$name" "$wt" "$port"
  write_rc    "$name" "$wt" "$port"

  info "Starting detached screen session $(session "$name")"
  screen -dmS "$(session "$name")" -c "$(rc_path "$name")"

  local head; head=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null || echo '?')

  cat <<EOF

Workspace '$name' is ready.
  path        $wt
  branch      detached HEAD @ $head
  namespace   $name   (ARWEAVE_NAMESPACE — picked up by ./bin/test)
  EPMD port   $port   (ERL_EPMD_PORT — a private EPMD for this workspace)
  screen      $(session "$name")

Start work by checking out a branch:
  git checkout -b <branch>      create a new branch here
  git checkout <branch>         switch to an existing branch

Open another shell in this workspace any time with: $PROG shell $name
Note: the first ./bin/test run compiles from scratch and is slow.
EOF

  if [ "$attach" -eq 1 ]; then
    cmd_attach "$name"   # execs into screen — does not return
  else
    echo "Attach with:  $PROG attach $name"
  fi
}

# Ensure screen session <sess> is alive, starting it from <rc> if not.
ensure_session_rc() {
  local sess=$1 rc=$2
  screen_alive "$sess" && return 0
  [ -f "$rc" ] \
    || die "workspace has no screen config; recreate it with '$PROG rm' then '$PROG new'"
  info "screen session $sess not running — starting it"
  screen -dmS "$sess" -c "$rc"
}

# screen forbids attaching from inside another screen session ($STY set), and
# it is almost never what you want. Bail out with a useful hint if so.
refuse_if_nested() {  # refuse_if_nested <target-session> <retry-command>
  [ -n "${STY:-}" ] || return 0
  if [ "${STY#*.}" = "$1" ]; then
    die "you are already inside session $1 — nothing to attach (detach: Ctrl-A d)."
  fi
  die "you are inside another screen session (${STY#*.}).
  Detach from it first with Ctrl-A d, then run:  $2"
}

cmd_attach() {
  local name=${1:-} num=${2:-}
  [ -n "$name" ] || die "usage: $PROG attach <name> [N]"
  [ -d "$(wt_path "$name")" ] || die "no such workspace: $name  (see '$PROG ls')"

  # No N -> the primary session 'ws-<name>'. N -> a 'ws-<name>#N' shell
  # session (as created by '$PROG shell'); start it fresh if it has died.
  local sess
  if [ -n "$num" ]; then
    case $num in
      ''|*[!0-9]*) die "session number must be a positive integer: $num" ;;
    esac
    sess=$(session_n "$name" "$num")
  else
    sess=$(session "$name")
  fi

  refuse_if_nested "$sess" "$PROG attach $name${num:+ $num}"
  ensure_session_rc "$sess" "$(rc_path "$name")"

  # Each ws session drives a single terminal, so -d -r is right: it steals the
  # session back from a stale display (e.g. a dropped ssh) and reattaches here.
  # It only ever touches this one session — never another workspace or shell.
  exec screen -d -r "$sess"
}

cmd_shell() {
  local name=${1:-}
  [ -n "$name" ] || die "usage: $PROG shell <name>"
  [ -d "$(wt_path "$name")" ] || die "no such workspace: $name  (see '$PROG ls')"
  local rc; rc=$(rc_path "$name")
  [ -f "$rc" ] \
    || die "workspace '$name' has no screen config; recreate it with '$PROG rm $name' then '$PROG new $name'"

  # A 'shell' is its own independent screen session — ws-<name>#N — in the
  # same worktree, not a window in (or a second display of) the primary
  # session. So every terminal, and every concurrent agent, gets a private
  # disconnect-proof shell that never resizes, mirrors, or detaches another.
  local n sess
  n=$(next_session_n "$name")
  sess=$(session_n "$name" "$n")
  info "Starting independent screen session $sess"
  screen -dmS "$sess" -c "$rc"

  if [ -n "${STY:-}" ]; then
    cat <<EOF

Created session $sess for workspace '$name'.
You are inside another screen session, so ws cannot attach you from here.
Detach (Ctrl-A d) and run, or from another terminal:  $PROG attach $name $n
EOF
    exit 0
  fi
  exec screen -d -r "$sess"
}

cmd_rm() {
  local name='' force=0 delbranch=0
  while [ $# -gt 0 ]; do
    case $1 in
      --force)         force=1 ;;
      --delete-branch) delbranch=1 ;;
      -*)              die "unknown option: $1" ;;
      *)               [ -z "$name" ] && name=$1 || die "unexpected argument: $1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: $PROG rm <name> [--force] [--delete-branch]"
  local wt; wt=$(wt_path "$name")
  [ -d "$wt" ] || die "no such workspace: $name  (see '$PROG ls')"

  local branch; branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')

  # Our own dirty check: ignore submodules (their build output is not work)
  # and the .envrc that ws itself generates.
  if [ "$force" -ne 1 ] \
     && [ -n "$(git -C "$wt" status --porcelain --ignore-submodules=all \
                 -- . ':!.envrc' 2>/dev/null)" ]; then
    die "workspace '$name' has uncommitted changes — commit/push first, or rerun with --force"
  fi

  local s
  for s in $(workspace_sessions "$name"); do
    info "Killing screen session $s"
    screen -S "$s" -X quit || true
  done

  local port; port=$(rc_get "$name" ERL_EPMD_PORT)
  if [ -n "$port" ]; then
    info "Stopping this workspace's EPMD (port $port)"
    epmd -port "$port" -kill >/dev/null 2>&1 || true
  fi

  info "Removing worktree $wt"
  # git refuses to remove a worktree that contains submodules, so deinit them
  # first; fall back to a plain rm + prune if git still declines.
  git -C "$wt" submodule deinit -f --all >/dev/null 2>&1 || true
  if ! git -C "$MAIN_ROOT" worktree remove --force "$wt" 2>/dev/null; then
    rm -rf "$wt"
    git -C "$MAIN_ROOT" worktree prune
  fi
  rm -f "$(rc_path "$name")"

  if [ "$branch" = HEAD ] || [ "$branch" = '?' ]; then
    echo
    echo "Worktree was on a detached HEAD — no branch to clean up."
  elif [ "$delbranch" -eq 1 ]; then
    info "Deleting branch $branch"
    git -C "$MAIN_ROOT" branch -D "$branch"
  else
    echo
    echo "Branch '$branch' kept. Delete it when done with:"
    echo "  git -C $MAIN_ROOT branch -d $branch"
  fi
}

cmd_ls() {
  # Two passes: collect every row, sizing each column to its widest value
  # (branch names and paths vary a lot), then print aligned. Column widths
  # start at the header lengths so headers always fit.
  local found=0 wt name branch nsess port
  local w_name=4 w_branch=6 w_sess=8 w_port=4   # NAME BRANCH SESSIONS EPMD
  local -a rows=()
  while read -r wt; do
    case $wt in "$WS_ROOT"/*) ;; *) continue ;; esac
    found=1
    name=$(basename "$wt")
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
    [ "$branch" = HEAD ] && branch='(detached)'
    nsess=$(workspace_sessions "$name" | grep -c . || true)
    port=$(rc_get "$name" ERL_EPMD_PORT); port=${port:--}
    rows+=("$name"$'\t'"$branch"$'\t'"$nsess"$'\t'"$port"$'\t'"$wt")
    [ ${#name}   -gt "$w_name"   ] && w_name=${#name}
    [ ${#branch} -gt "$w_branch" ] && w_branch=${#branch}
    [ ${#nsess}  -gt "$w_sess"   ] && w_sess=${#nsess}
    [ ${#port}   -gt "$w_port"   ] && w_port=${#port}
  done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')

  if [ "$found" -ne 1 ]; then
    echo "(no workspaces — create one with '$PROG new <name>')"
    return 0
  fi

  local fmt="%-${w_name}s  %-${w_branch}s  %-${w_sess}s  %-${w_port}s  %s\n"
  printf "$fmt" NAME BRANCH SESSIONS EPMD PATH
  local row
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r name branch nsess port wt <<<"$row"
    printf "$fmt" "$name" "$branch" "$nsess" "$port" "$wt"
  done
}

cmd_current() {
  # Identify the workspace we are in: ARWEAVE_NAMESPACE is set inside every
  # workspace session; fall back to deriving it from the current directory.
  local name=${ARWEAVE_NAMESPACE:-}
  if [ -z "$name" ]; then
    case "$PWD/" in
      "$WS_ROOT"/*) name=${PWD#"$WS_ROOT"/}; name=${name%%/*} ;;
    esac
  fi
  [ -n "$name" ] \
    || die "not inside a ws workspace (ARWEAVE_NAMESPACE unset, cwd not under $WS_ROOT)"
  local wt; wt=$(wt_path "$name")
  [ -d "$wt" ] || die "current namespace is '$name' but no workspace exists at $wt"

  local branch head port sessions changes
  branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
  head=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null || echo '?')
  [ "$branch" = HEAD ] && branch='detached HEAD'
  port=$(rc_get "$name" ERL_EPMD_PORT); port=${port:-${ERL_EPMD_PORT:-?}}
  sessions=$(workspace_sessions "$name" | paste -sd' ' -)
  [ -n "$sessions" ] || sessions='(none running)'
  changes=$(git -C "$wt" status --porcelain --ignore-submodules=all \
              -- . ':!.envrc' 2>/dev/null | wc -l | tr -d ' ' || echo 0)

  cat <<EOF
workspace    $name
path         $wt
branch       $branch @ $head
EPMD port    $port
sessions     $sessions
changes      $changes file(s) modified vs HEAD
EOF
}

usage() {
  cat <<EOF
$PROG — Arweave development workspace manager

A workspace is an isolated git worktree + named screen session + unique Erlang
test namespace, so multiple engineers or agents can build and run the test
suite concurrently on one machine without colliding.

Usage:
  $PROG new <name> [--no-attach]  Create a workspace and attach to it. The
                                  worktree starts on a detached HEAD at master;
                                  check out or create a branch yourself once
                                  inside. --no-attach skips attaching (useful
                                  for spinning up several).
  $PROG attach <name> [N]         Attach to the workspace's primary screen
                                  session, starting it if needed. Ctrl-A d
                                  detaches. With N, attach shell session #N
                                  (as opened by '$PROG shell') instead.
  $PROG shell <name>              Start a NEW independent screen session
                                  (ws-<name>#N) in the workspace and attach to
                                  it. Run it from several terminals — or
                                  several agents — to get a private shell in
                                  each; the sessions never share a display,
                                  resize each other, or detach one another.
  $PROG current                   Show details of the workspace you are in.
  $PROG ls                        List all workspaces (SESSIONS = how many
                                  screen sessions each currently has live).
  $PROG rm <name> [--force]       Destroy a workspace: kill all its screen
            [--delete-branch]     sessions and its EPMD, remove the worktree.
                                  The branch is kept unless --delete-branch is
                                  given; --force removes a worktree with edits.
  $PROG help                      Show this help.

Environment:
  ARWEAVE_WS_ROOT   Where worktrees live. Default: <repo>/../arweave-workspaces

Each workspace exports (via screen, and a .envrc for non-screen shells):
  ARWEAVE_NAMESPACE=<name>   read by ./bin/test to give the Erlang test node a
                             unique name (and unique peer nodes / data dirs).
  ERL_EPMD_PORT=<43xx>       a private EPMD, so node names can never collide
                             with another workspace even by accident.
EOF
}

# --- dispatch -------------------------------------------------------------

cmd=${1:-help}
shift || true
case $cmd in
  new)               cmd_new "$@" ;;
  attach|a)          cmd_attach "$@" ;;
  shell|sh)          cmd_shell "$@" ;;
  current|cur)       cmd_current "$@" ;;
  ls|list)           cmd_ls "$@" ;;
  rm|remove|destroy) cmd_rm "$@" ;;
  help|-h|--help)    usage ;;
  *)                 err "unknown subcommand: $cmd"; echo; usage; exit 1 ;;
esac
