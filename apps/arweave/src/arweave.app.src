{application, arweave,
 [
  {description, "Arweave"},
  {vsn, "2.9.7-alpha1-dev-sync-performance-20260909"},
  {mod, {ar, []}},
  {applications, 
   [
    kernel,
    stdlib,
    sasl,
    os_mon,
    gun,
    cowlib,
    ranch,
    cowboy,
    prometheus,
    prometheus_cowboy,
    prometheus_process_collector,
    prometheus_httpd,
    runtime_tools,
    arweave_metrics,
    arweave_limiter,
    arweave_throttling
   ]},
  {extra_applications, [recon]}
 ]}.
