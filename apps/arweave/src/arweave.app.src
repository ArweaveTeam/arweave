{application, arweave,
 [
  {description, "Arweave"},
  {vsn, "2.9.7-alpha1"},
  {mod, {ar, []}},
  {applications, 
   [
    kernel,
    stdlib,
    sasl,
    os_mon,
    gun,
    cowlib,
    ranch,
    cowboy,
    prometheus,
    prometheus_cowboy,
    prometheus_process_collector,
    prometheus_httpd,
    runtime_tools,
    arweave_constants,
    arweave_metrics,
    arweave_limiter,
    arweave_throttling,
    arweave_sync,
    arweave_storage,
    arweave_entropy
   ]},
  {extra_applications, [recon]}
 ]}.
